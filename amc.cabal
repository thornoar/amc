cabal-version:      3.0
name:               amc
version:            0.1.0.0
synopsis:           A multi-purpose advanced mathematical calculator
license:            MIT
license-file:       LICENSE
author:             Roman Maksimovich
maintainer:         r.a.maksimovich@gmail.com
category:           Math
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common common
    ghc-options: -Wall
    default-extensions:
        DataKinds
        GADTs
        StandaloneKindSignatures
        FlexibleInstances

library amclib
    import:           common
    hs-source-dirs:
        lib,
    exposed-modules:
        Input,
        Object.Bundle,
        Object.RealNumber,
        Action.Display.Bundle,
        Action.Display.Render,
        Action.Display.Instances.IEX,
        Action.Display.Instances.REX,
        Action.Bundle,
        Action.Simplify.Bundle,
        Action.Simplify.Instances.IEX,
        Action.Simplify.Instances.REX,
        Action.Substitute.Bundle,
        Action.Substitute.Instances.IEX,
        Action.Substitute.Instances.REX,
        Result,
        Description,
        Parse.Bundle,
        Parse.Instances.IEX,
        Parse.Instances.REX,
    default-language: Haskell2010
    build-depends:
        base ^>=4.20.2.0,
        haskeline,
        containers,

executable amc
    import:           common
    main-is:          Main.hs
    build-depends:
        base ^>=4.20.2.0,
        haskeline,
        containers,
        Unique,
        amclib,
    hs-source-dirs:   app
    default-language: Haskell2010
